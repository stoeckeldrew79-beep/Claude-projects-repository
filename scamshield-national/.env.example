# Database
DATABASE_URL=postgresql://scamshield:scamshield@localhost:5432/scamshield
REDIS_URL=redis://localhost:6379

# Auth (dev-mode JWT; swap for Auth0/Supabase in Phase 2)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
JWT_SECRET=change-me-in-every-environment
# Comma-separated emails that get role:admin from the dev-mode auth stub.
# Not needed once real Auth0/Supabase role claims are wired up.
ADMIN_EMAILS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_BUSINESS=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@scamshieldnational.com

# Anthropic (npm run draft-articles — drafts land unpublished for admin review, never auto-published)
ANTHROPIC_API_KEY=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=scamshield-assets

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
