# Copy this file to .env and fill in the real values. .env is gitignored,
# so nothing here was ever committed — if your local setup is failing in a
# way that never shows up for anyone else, a mismatched .env credential
# against docker-compose.yml is the first thing to check.

# Must match docker-compose.yml's postgres service exactly (user, password,
# db name, and the 5432 port it publishes). If you're running Postgres some
# other way (a native install, WSL), point this at that instead.
DATABASE_URL=postgresql://scamshield:scamshield@localhost:5432/scamshield

PORT=3000
NODE_ENV=development

# The frontend origin allowed by CORS. The frontend dev server defaults to
# http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# Any random long string works for local dev — this only needs to be stable
# and secret in production.
JWT_SECRET=

# Optional in local dev — leave blank to skip the feature it powers.
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADMIN_EMAILS=
